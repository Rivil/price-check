# Drizzle
DATABASE_URL=file:local.db

# Alert channel credentials
# Encrypts saved ntfy topics and tokens at rest. Required: the server refuses to
# start without it. Generate with: openssl rand -base64 32
# Keep it with your backups — without it, saved channel credentials must be re-entered.
ALERTS_ENCRYPTION_KEY=""

# Scheduled re-checks
# Hours between checks of each watch (1-168, default 6)
CHECK_INTERVAL_HOURS=6
# Set to 1 to disable the scheduler (e2e runs do this)
SCHEDULER_DISABLED=
